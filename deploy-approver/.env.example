# GitHub token used to fire the repository_dispatch (the deploy trigger).
# Needs write access to trigger workflows:
#   - fine-grained PAT with "Contents: Read and write" on this repo, OR
#   - classic PAT with the "repo" scope.
GH_TOKEN=

# Target repository the dispatch is sent to (owner/repo).
GH_REPO=lucasmiranda-stark/ecdsa-node

# repository_dispatch event_type — must match `types:` in deploy-npm.yml.
GH_EVENT_TYPE=deploy

# Number of distinct approvals required before a request can be processed.
REQUIRED_APPROVALS=2

# Optional shared bearer token protecting this API. Leave empty to disable auth.
APPROVE_API_TOKEN=
